[gd_resource type="Resource" script_class="UnexpectedEncounterDefinition" format=3]

[ext_resource type="Script" path="res://run/encounter/unexpected_encounter_definition.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/ui/encounter-camp.png" id="2"]
[ext_resource type="Script" path="res://run/encounter/unexpected_encounter_option_definition.gd" id="3_option"]

[sub_resource type="Resource" id="Option_heal"]
script = ExtResource("3_option")
option_id = "heal"
label = "休息片刻 · 恢复15生命"
result_text = "你恢复了{actual_heal}点生命。"
operation = 1
heal_amount = 15

[sub_resource type="Resource" id="Option_card"]
script = ExtResource("3_option")
option_id = "card"
label = "翻阅手记 · 从3张普通卡牌中选择1张"
result_text = "你获得了「{card_name}」。"
operation = 2
card_rarities = Array[int]([0])
excluded_card_ids = Array[String](["strike", "defend"])

[sub_resource type="Resource" id="Option_leave"]
script = ExtResource("3_option")
option_id = "leave"
label = "离开 · 保留当前生命与牌组"
result_text = "你绕过了此地，继续踏上旅途。"

[resource]
script = ExtResource("1")
encounter_id = "ember_camp"
display_name = "余烬营地"
story = "熄灭的营火下仍埋着温热的余烬。你可以稍作休息，也可以从散落的旅人手记中学到一项普通技艺。"
artwork = ExtResource("2")
options = Array[ExtResource("3_option")]([SubResource("Option_heal"), SubResource("Option_card"), SubResource("Option_leave")])
kind = 0
heal_amount = 15
