[gd_resource type="Resource" script_class="UnexpectedEncounterDefinition" format=3]

[ext_resource type="Script" path="res://run/encounter/unexpected_encounter_definition.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/ui/encounter-fountain.png" id="2"]
[ext_resource type="Script" path="res://run/encounter/unexpected_encounter_option_definition.gd" id="3_option"]

[sub_resource type="Resource" id="Option_remove"]
script = ExtResource("3_option")
option_id = "remove"
label = "洗去负担 · 选择并删除牌组中的1张卡牌"
result_text = "你忘却了「{card_name}」，牌组减少一张卡牌。"
operation = 3
disabled_reason = "牌组至少保留1张卡牌"

[sub_resource type="Resource" id="Option_heal"]
script = ExtResource("3_option")
option_id = "heal"
label = "休息片刻 · 恢复8生命"
result_text = "你恢复了{actual_heal}点生命。"
operation = 1
heal_amount = 8

[sub_resource type="Resource" id="Option_leave"]
script = ExtResource("3_option")
option_id = "leave"
label = "离开 · 保留当前生命与牌组"
result_text = "你绕过了此地，继续踏上旅途。"

[resource]
script = ExtResource("1")
encounter_id = "forgetting_spring"
display_name = "遗忘之泉"
story = "泉水映出的并非面容，而是过去反复练习的招式。饮水可以缓解伤势，把双手浸入水中则能忘却一项不再需要的技艺。"
artwork = ExtResource("2")
options = Array[ExtResource("3_option")]([SubResource("Option_remove"), SubResource("Option_heal"), SubResource("Option_leave")])
kind = 2
heal_amount = 8
